<?xml version="1.0"?>
<ruleset name="Holiday Mode for HivePress">
	<description>HivePress coding standards.</description>

	<exclude-pattern>vendor/*</exclude-pattern>

	<!-- The test harness is not production code and never ships (package.ps1
	     excludes tests?/). It deliberately breaks the standards it would be
	     measured against: it redefines core WordPress functions as stubs, keeps
	     whole assertions on one line so a failure reads as one grep-able line,
	     and has no file or function doc blocks by design. Linting it produced
	     695 errors that said nothing about the plugin. -->
	<exclude-pattern>tests/*</exclude-pattern>

	<rule ref="WordPress">
		<exclude name="WordPress.PHP.StrictInArray.MissingTrueStrict"/>
		<exclude name="WordPress.NamingConventions.ValidHookName.UseUnderscores"/>
		<exclude name="Squiz.Commenting.InlineComment.InvalidEndChar"/>
		<exclude name="Generic.Files.LineEndings.InvalidEOLChar"/>
		<exclude name="Squiz.Commenting.FileComment.WrongStyle"/>
		<exclude name="Squiz.Commenting.FunctionComment.ParamCommentFullStop"/>
		<exclude name="Generic.Commenting.DocComment.MissingShort"/>
	</rule>

	<!-- HivePress uses short array syntax. The sniff moved namespaces in newer
	     WordPress standards, so both homes are silenced. -->
	<rule ref="Generic.Arrays.DisallowShortArraySyntax.Found">
		<severity>0</severity>
	</rule>

	<rule ref="Universal.Arrays.DisallowShortArraySyntax.Found">
		<severity>0</severity>
	</rule>

	<!-- HivePress core hook callbacks name the model parameter $object. -->
	<rule ref="Universal.NamingConventions.NoReservedKeywordParameterNames.objectFound">
		<severity>0</severity>
	</rule>

	<rule ref="Squiz.Functions.MultiLineFunctionDeclaration.SpaceAfterFunction">
		<severity>0</severity>
	</rule>

	<!-- The main plugin file must be named after the plugin slug, and by
	     WordPress convention it declares the plugin class alongside its
	     bootstrap functions. -->
	<rule ref="WordPress.Files.FileName.InvalidClassFileName">
		<exclude-pattern>*/holiday-mode-for-hivepress\.php$</exclude-pattern>
	</rule>

	<rule ref="Universal.Files.SeparateFunctionsFromOO.Mixed">
		<exclude-pattern>*/holiday-mode-for-hivepress\.php$</exclude-pattern>
	</rule>

	<!-- The plugin header declares "Requires PHP: 7.4", matching HivePress core, so compatibility
	     is checked from that version upwards. HivePress is a hard dependency: a site below its
	     floor cannot run this plugin at all. -->
	<config name="testVersion" value="7.4-"/>
	<rule ref="PHPCompatibility"/>

	<rule ref="Generic.Arrays.DisallowLongArraySyntax.Found"/>
</ruleset>
